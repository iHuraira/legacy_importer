# Preferred: provide one complete PostgreSQL URI.
SEQQUERY_DATABASE_URI=postgresql://user:password@127.0.0.1:5432/database

# Component fallback used when SEQQUERY_DATABASE_URI and AIRFLOW_CONN_POSTGRES are absent.
SEQQUERY_DATABASE_USER=postgres
SEQQUERY_DATABASE_PASSWORD=replace-me
SEQQUERY_DATABASE_NAME=postgres
SEQQUERY_DATABASE_HOST=127.0.0.1
SEQQUERY_DATABASE_PORT=5432
SEQQUERY_DATABASE_SSLMODE=prefer

# The configured local fallback is .secrets/legacy-importer.json.
# This environment variable overrides it.
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json

# Alternative: put the full service-account JSON in this variable.
# SEQQUERY_GCP_CREDENTIALS={"type":"service_account",...}
